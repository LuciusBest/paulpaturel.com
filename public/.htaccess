RewriteEngine On

# 1) Redirect all traffic to canonical HTTPS hostname (non-www)
#    This ensures one, consistent URL in Google: https://paulpaturel.com/
RewriteCond %{HTTP_HOST} !^paulpaturel\.com$ [NC]
RewriteRule ^ https://paulpaturel.com%{REQUEST_URI} [L,R=301]

# 2) Enforce HTTPS on the canonical host.
#    If behind a proxy/CDN setting X-Forwarded-Proto=https, do not loop.
RewriteCond %{HTTP_HOST} ^paulpaturel\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://paulpaturel.com%{REQUEST_URI} [L,R=301]

# 3) Security headers that reinforce HTTPS.
#    HSTS tells browsers to always use HTTPS for this domain.
<IfModule mod_headers.c>
  # HSTS: one year. Add includeSubDomains + preload only if all subdomains are HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "0"
  Header set Content-Security-Policy "upgrade-insecure-requests"
</IfModule>

# 4) Static asset caching (conservative: 30 days for images/fonts/css/js, 7 days for video)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType font/woff "access plus 30 days"
  ExpiresByType font/otf "access plus 30 days"
  ExpiresByType font/ttf "access plus 30 days"
  ExpiresByType video/mp4 "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|webp|woff2?|otf|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# 5) Legacy path redirects (mirrored in redirects.csv)
Redirect 301 /CosmaWebTypeTester/ /
Redirect 301 /CosmaWebTypeTester/index.html /
Redirect 301 /CosmaWebTypeTester/css/style.css /css/projectsLayout.css
Redirect 301 /CosmaWebTypeTester/js/script.js /js/projects/cosma_tester_embed.js
Redirect 301 /CosmaWebTypeTester/fonts/Cosma-VF.woff2 /font/Cosma-VF.woff2
Redirect 301 /css/navigation.css /css/ui.css
Redirect 301 /css/toper.css /css/style.css
Redirect 301 /js/media/diaporama.js /js/media/diaporama_mouse.js
